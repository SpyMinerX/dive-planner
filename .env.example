# Abyss server configuration. On AegisMesh these are set in stack.portainer.yml.
PORT=8080

# Behind Traefik / Cloudflare: take the client IP from CF-Connecting-IP / X-Forwarded-For
TRUST_PROXY=1

# PostgreSQL — always the HA endpoint on AegisMesh, never a node IP
DB_HOST=postgres-ha
DB_PORT=5000
DB_NAME=abyss
DB_USER=abyss
# Secret: supply as a Swarm secret via DB_PASSWORD_FILE=/run/secrets/abyss_db_password
DB_PASSWORD=<SECRET>
# Alternative to the DB_* variables:
# DATABASE_URL=postgresql://abyss:<SECRET>@postgres-ha:5000/abyss

# Optional
# DB_POOL_MAX=10
# APP_VERSION=2.0.0   # overrides the release fingerprint used for "new version" prompts
